# SPDX-License-Identifier: MIT
# qsfp28-fmc-rocelet: the register window, the PS DDR window and (VCK190) the MRMAC registers
# (generic UIO, device-tree linux,uio-name) for roceletd; group rocelet
SUBSYSTEM=="uio", ATTR{name}=="rocelet-regs", SYMLINK+="rocelet-regs", GROUP="rocelet", MODE="0660"
SUBSYSTEM=="uio", ATTR{name}=="rocelet-ddr", SYMLINK+="rocelet-ddr", GROUP="rocelet", MODE="0660"
SUBSYSTEM=="uio", ATTR{name}=="rocelet-mrmac", SYMLINK+="rocelet-mrmac", GROUP="rocelet", MODE="0660"
