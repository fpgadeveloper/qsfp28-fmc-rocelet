# roceletd (daemon) and rl (CLI) for the qsfp28-fmc-rocelet Linux flow. The daemon compiles the
# console sources of the standalone builds (Vitis/common/src, one source tree) with PLAT_LINUX and
# the compatibility headers in compat/; plat.c (standalone only) is replaced by plat_linux.c.
#
#   make                       native or cross build (CC from the environment: Yocto, an SDK)
#   make BOARD=ZCU106 LINE_RATE=40     (Yocto: from config/data.json, rocelet-tools.bb)
#   make install DESTDIR=... BINDIR=/usr/bin

REPO      ?= $(abspath $(CURDIR)/../../..)
CONSOLE   ?= $(REPO)/Vitis/common/src
ROCELET_SW ?= $(REPO)/submodules/rocelet/sw
BOARD     ?= ZCU106
LINE_RATE ?= 40
BINDIR    ?= /usr/bin

CC        ?= gcc
CFLAGS    ?= -O2 -g
override CFLAGS += -Wall -Wno-unused-parameter -std=gnu11 -DPLAT_LINUX=1
override CPPFLAGS += -I$(CURDIR)/build -I$(CURDIR) -I$(CURDIR)/compat -I$(CONSOLE) -I$(ROCELET_SW)

CONSOLE_SRC := main.c eng.c mac.c sysif.c selftest.c hsb.c si5328.c util.c
DAEMON_SRC  := roceletd.c plat_linux.c hsb_net.c
OBJ := $(addprefix build/,$(CONSOLE_SRC:.c=.o) $(DAEMON_SRC:.c=.o))

all: build/roceletd build/rl

build/board.h: Makefile
	@mkdir -p build
	@printf '/* generated by sw/linux/roceletd/Makefile */\n#ifndef BOARD_H_\n#define BOARD_H_\n#define BOARD_NAME "%s"\n#define BOARD_%s 1\n#define LINE_RATE %s\n#define LINE_RATE_25G 0\n#endif\n' \
		"$(BOARD)" "$(BOARD)" "$(LINE_RATE)" > $@

build/%.o: $(CONSOLE)/%.c build/board.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build/%.o: %.c build/board.h
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

build/roceletd: $(OBJ)
	$(CC) $(LDFLAGS) -o $@ $^

build/rl: rl.c roceletd.h
	@mkdir -p build
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ rl.c

install: all
	install -d $(DESTDIR)$(BINDIR)
	install -m 0755 build/roceletd build/rl $(DESTDIR)$(BINDIR)/

clean:
	rm -rf build

.PHONY: all install clean
